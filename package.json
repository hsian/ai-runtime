{
  "name": "ai-runtime",
  "private": true,
  "workspaces": [
    "web",
    "extension",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w server",
    "dev:extension": "npm run dev -w extension",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server"
  }
}
