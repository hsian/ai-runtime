# 服务端口（Chrome 会拦截 6000 等端口，推荐 6080/8080）
PORT=6080

# Git 仓库（必填）
GIT_REPO_URL=https://github.com/your-org/your-repo.git
GIT_ACCESS_TOKEN=ghp_xxxxxxxxxxxx
GIT_DEFAULT_BRANCH=test
GIT_AUTHOR_NAME=AI Runtime Bot
GIT_AUTHOR_EMAIL=ai-runtime@company.com

# 本地 Git 仓库路径（必填）
WORKSPACE_DIR=./workspace

# Agent 执行引擎。前端可按任务切换；未传时使用这里的默认值
AGENT_PROVIDER=claude

# Claude Code CLI（模型和 Key 由 ~/.claude/settings.json 或 cc-switch 配置）
CLAUDE_CLI_PATH=claude
CLAUDE_TIMEOUT_MS=1200000
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_SKIP_PERMISSIONS=true
CLAUDE_SETTING_SOURCES=user,project

# Codex CLI（先在服务器机器上安装并完成 codex login）
CODEX_CLI_PATH=codex
CODEX_TIMEOUT_MS=1200000
CODEX_ENABLE_SYSTEM_PROXY=true
CODEX_DISABLE_WEBSOCKETS=true
CODEX_DISABLED_FEATURES=plugins,remote_plugin,skill_search,skill_mcp_dependency_install,tool_suggest
CODEX_SANDBOX_MODE=workspace-write
CODEX_READ_ONLY_SANDBOX_MODE=read-only
CODEX_APPROVE_FOR_ME=true
CODEX_BYPASS_SANDBOX=false

# Git 自动化
AUTO_PUSH=true
GIT_SKIP_HOOKS=true

# 合并/MR 确认前读取改动 app 的 .env.testing 中 VITE_PORT 生成预览地址（不启动 dev 进程）
PREVIEW_DEV_ENABLED=true

# CORS 仅用于 Vite 跨端口开发；生产环境 Web 与 API 同源
CORS_ORIGIN=http://localhost:5173

# 操作日志（按天写入 JSONL，自动清理过期文件）
OPERATION_LOG_ENABLED=true
OPERATION_LOG_DIR=./data/logs
OPERATION_LOG_RETENTION_DAYS=7
OPERATION_LOG_MAX_FILE_MB=20

# SQLite 任务历史与自动清理
DATABASE_PATH=./data/ai-runtime.sqlite
JOB_RETENTION_DAYS=30

# Web 匿名客户端身份；不填写时首次启动自动生成本地密钥文件
CLIENT_COOKIE_SECRET=
CLIENT_COOKIE_SECRET_FILE=./data/client-cookie-secret
CLIENT_COOKIE_NAME=ai_runtime_client
CLIENT_COOKIE_MAX_AGE_DAYS=365
# 当前内网 HTTP 部署保持 false，启用 HTTPS 后改为 true
CLIENT_COOKIE_SECURE=false

# React Web 构建产物，由 Express 同源托管
WEB_DIST_DIR=../web/dist

# TAPD Open API（可选；应用 ID + 密钥来自 o.tapd.cn 开发者后台）
TAPD_API_BASE=https://api.tapd.cn
TAPD_CLIENT_ID=
TAPD_CLIENT_SECRET=
TAPD_WORKSPACE_ID=
# 可选：当 TAPD 应用没有项目列表 API 权限时，用这里配置可选项目。
# 格式：项目ID:项目名,项目ID2:项目名2
TAPD_WORKSPACES=
